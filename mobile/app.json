{
  "expo": {
    "name": "WhatsApp Clone",
    "slug": "whatsapp-clone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#075E54"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.whatsappclone.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses camera for video calls",
        "NSMicrophoneUsageDescription": "This app uses microphone for voice calls",
        "NSPhotoLibraryUsageDescription": "This app needs access to photo library for sharing images"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#075E54"
      },
      "package": "com.whatsappclone.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "apiUrl": null,
      "socketUrl": null
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow WhatsApp Clone to access your microphone."
        }
      ]
    ]
  }
}
